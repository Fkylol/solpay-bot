# Obligatoire — LLM via endpoint compatible OpenAI (Groq, offre gratuite)
LLM_API_KEY=gsk-factice-a-remplacer
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Variante abonnement opencode Go (endpoint interne, inutilisable hors opencode) :
# LLM_BASE_URL=https://opencode.ai/zen/go/v1

# Compat plugin-openai officiel (mêmes valeurs, requis par le plugin) :
OPENAI_API_KEY=gsk-factice-a-remplacer
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_SMALL_MODEL=openai/gpt-oss-20b
OPENAI_LARGE_MODEL=openai/gpt-oss-20b
# Pas d'embeddings côté opencode Zen (vérifié via GET /models : aucun modèle embedding).
# Le plugin-openai garde son modèle d'embedding par défaut ; le démarrage
# n'est pas bloqué (dimension résolue localement, file d'embeddings vide).

# Optionnel — nom de chaîne (bloc futur, ignoré pour l'instant)
# CHAIN_NAME=

# --- Produit (marque blanche SolPay Bot Starter Kit) ---
BOT_NAME=SolPay
PAYMENT_TOKEN_SYMBOL=SOL
# false = version Lite (paywall désactivé, chaque question consomme du quota LLM)
PAYWALL_ENABLED=true
# --- Solana / paiements (Bloc 2, Devnet gratuit) ---
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
# Vide => portefeuille Devnet éphémère généré automatiquement pour les tests.
# Pour un wallet persistant : clé privée base58 (64 octets), NE JAMAIS committer.
# SOLANA_PRIVATE_KEY=
PAYMENT_PRICE_SOL=0.1
PAYMENT_MIN_CONFIRMATIONS=1
# Débloque le mainnet (argent réel) : à laisser absent en dev.
# CONFIRM_MAINNET=true

# Optionnel — X/Twitter (Bloc 3 : DRY_RUN par défaut, aucun post réel)
# Rappel : sans tier X payant, le plugin s'authentifie mais ne peut rien lire
# (402 credits-depleted). Laisser DRY_RUN=true en attendant.
TWITTER_DRY_RUN=true
TWITTER_POLL_INTERVAL=60
# Optionnels en DRY_RUN, obligatoires en mode live (TWITTER_DRY_RUN=false) :
# TWITTER_USERNAME=
# TWITTER_PASSWORD=
# TWITTER_EMAIL=

# --- Telegram (boucle payante full-auto, API 100 % gratuite) ---
# Crée le bot via @BotFather sur Telegram (/newbot), puis renseigne :
# TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_POLL_TIMEOUT_SEC=30
TELEGRAM_USER_COOLDOWN_SEC=60
# TWITTER_USERNAME=
# TWITTER_PASSWORD=
# TWITTER_EMAIL=
# TWITTER_API_KEY=
# TWITTER_API_SECRET=
# TWITTER_ACCESS_TOKEN=
# TWITTER_ACCESS_SECRET=

LOG_LEVEL=info
